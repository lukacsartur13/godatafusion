# ============================================================
# GoDataFusion — environment contract
#
# Copy to `.env` for local development. `.env` is git-ignored; never
# commit real keys. Vite loads this file into process.env for the dev and
# preview API middleware; on Netlify set the same names in
# Site configuration → Environment variables.
# ============================================================

# ---- transactional email -----------------------------------------
# Which provider actually sends the inquiry.
#   resend    — https://resend.com, needs RESEND_API_KEY
#   postmark  — https://postmarkapp.com, needs POSTMARK_SERVER_TOKEN
#   console   — DEVELOPMENT ONLY: prints the submission to the server log
#               and reports transport:"console" to the browser, which the
#               UI shows as an explicit dev-mode notice. Refused in
#               production unless MAIL_ALLOW_CONSOLE=1.
# Unset in production => the endpoint returns 503 and says it is not
# configured. It never pretends to have sent anything.
MAIL_TRANSPORT=console

# Where inquiries are delivered. Required for resend/postmark.
CONTACT_TO=

# Verified sender for the chosen provider, e.g. "GoDataFusion <no-reply@godatafusion.hu>".
# Must be on a domain verified with that provider or delivery will fail.
CONTACT_FROM=

# ---- provider credentials (set only the one you use) --------------
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
# POSTMARK_STREAM=outbound

# ---- escape hatch --------------------------------------------------
# Allow the console transport in a production context. Only for a staging
# deploy you are actively watching the logs of.
# MAIL_ALLOW_CONSOLE=0

# ---- build-time --------------------------------------------------
# Absolute origin used for canonical URLs, og:url and JSON-LD.
VITE_SITE_ORIGIN=https://godatafusion.hu
